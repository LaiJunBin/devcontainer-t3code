#!/usr/bin/env bash
# Looks after a dev container's T3 Code environment for the t3-server feature.
# The server itself is installed and started by the T3 Code app when it
# connects over SSH; this reports on it, stops it, and prepares the data
# volume and the SSH entry point.
set -euo pipefail

CONFIG="${T3_SERVER_CONFIG:-/usr/local/share/t3-server/config}"
# shellcheck source=/dev/null
. "$CONFIG"

DATA_DIR="$T3_SERVER_DATA_DIR"
# ~/.t3, linked to the data volume: the app installs the server under
# runtime/, the server keeps its state under userdata/, and the app's
# launcher keeps its log under ssh-launch/.
T3_HOME="${T3_SERVER_USER_HOME}/.t3"
RUNTIME_FILE="${T3_HOME}/userdata/server-runtime.json"
HOST_KEY="${DATA_DIR}/ssh/ssh_host_ed25519_key"
SESSION_ENV_DIR="${T3_SERVER_SESSION_ENV_DIR:-/run/t3-server}"
SESSION_ENV="${SESSION_ENV_DIR}/session-env"

usage() {
  cat <<EOF
Usage: t3-server <command>

  status            show whether the T3 Code server is running, and its version
  stop              stop it; the T3 Code app starts a new one when it reconnects
  logs [-n LINES]   show the server log without pairing secrets
  label             print the name T3 Code shows for this environment

The T3 Code app installs and starts the server when it connects over SSH.
EOF
}

fail() {
  echo "t3-server: $1" >&2
  exit 1
}

# The volume keeps the owner it was created with at image build. Dev container
# tools may then change the remote user's UID to match the host user, which
# leaves the volume owned by a UID nobody has. Whoever can fix that does: root
# directly, the user through password-less sudo where the image offers it.
repair_data_owner() {
  [ -d "$DATA_DIR" ] || return 0
  local want have owner
  want="$(id -u "$T3_SERVER_USER" 2>/dev/null)" || return 0
  have="$(stat -c %u "$DATA_DIR" 2>/dev/null)" || return 0
  [ "$want" = "$have" ] && return 0
  owner="${T3_SERVER_USER}:$(id -gn "$T3_SERVER_USER")"
  if [ "$(id -u)" -eq 0 ]; then
    chown -R "$owner" "$DATA_DIR" 2>/dev/null || true
  elif command -v sudo >/dev/null 2>&1; then
    sudo -n chown -R "$owner" "$DATA_DIR" 2>/dev/null || true
  fi
}

# The name T3 Code shows for this environment. Without help it is the
# hostname, which in a container is the container ID. T3 Code reads
# PRETTY_HOSTNAME from /etc/machine-info before the hostname, so a name built
# from the project's folder goes there: t3-<folder>, lowercased, with anything
# outside a-z, 0-9 and "-" turned into "-". t3-dev names the SSH host after
# the same folder, so the name picked when adding the environment is the name
# it then shows. T3_SERVER_LABEL (containerEnv) replaces the default.
MACHINE_INFO=/etc/machine-info
LABEL_MARKER="# PRETTY_HOSTNAME written by the t3-server dev container feature"

environment_label() {
  local label="${T3_SERVER_LABEL:-}"
  if [ -z "$label" ]; then
    # Dev container tools mount the project at /workspaces/<folder name>.
    local folder
    folder="$(awk '$5 ~ /^\/workspaces\/[^\/]+$/ { n = split($5, part, "/"); print part[n]; exit }' /proc/self/mountinfo 2>/dev/null || true)"
    if [ -n "$folder" ]; then
      label="t3-$(printf '%s' "$folder" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-')"
    fi
  fi
  # One line, no quotes: it ends up inside a quoted value.
  label="$(printf '%s' "$label" | tr -d '"\\\n\r' | tr -d "'" | cut -c1-64)"
  printf '%s' "$label"
}

apply_environment_label() {
  local label content
  label="$(environment_label)"
  [ -n "$label" ] || return 0
  # A machine-info that someone else wrote is theirs to keep.
  if [ -e "$MACHINE_INFO" ] && ! grep -qxF "$LABEL_MARKER" "$MACHINE_INFO" 2>/dev/null; then
    return 0
  fi
  content="${LABEL_MARKER}"$'\n'"PRETTY_HOSTNAME=\"${label}\""
  [ "$(cat "$MACHINE_INFO" 2>/dev/null)" = "$content" ] && return 0
  if [ "$(id -u)" -eq 0 ]; then
    printf '%s\n' "$content" >"$MACHINE_INFO" 2>/dev/null || true
  elif command -v sudo >/dev/null 2>&1; then
    printf '%s\n' "$content" | sudo -n tee "$MACHINE_INFO" >/dev/null 2>&1 || true
  fi
}

# Saves the environment this process got from `docker exec` (the container's
# environment) as shell assignments for the next SSH session's login shell.
# ssh-session runs this as root before it starts sshd. The file is readable
# by the user only, since containerEnv can hold credentials.
cmd_session_env() {
  [ "$(id -u)" -eq 0 ] || [ -n "${T3_SERVER_SESSION_ENV_DIR:-}" ] ||
    fail "session-env is run by ssh-session as root"
  local tmp kv name value
  mkdir -p "$SESSION_ENV_DIR"
  chmod 0755 "$SESSION_ENV_DIR"
  tmp="$(mktemp "${SESSION_ENV_DIR}/.session-env.XXXXXX")"
  {
    echo "# The container's environment, saved by t3-server for SSH sessions."
    while IFS= read -r -d '' kv; do
      name="${kv%%=*}"
      value="${kv#*=}"
      [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
      # Set by sshd or the login for this session, or about the session
      # itself; these must not be replaced with the container's.
      case "$name" in
        HOME | USER | LOGNAME | SHELL | MAIL | PWD | OLDPWD | SHLVL | TERM | _ | HOSTNAME | SSH_* | T3_SERVER_SSH_SESSION | T3_SERVER_SESSION_ENV_DIR | T3_SERVER_CONFIG) continue ;;
      esac
      printf "export %s='%s'\n" "$name" "${value//\'/\'\\\'\'}"
    done < <(env -0)
  } >"$tmp"
  if [ "$(id -u)" -eq 0 ]; then
    chown "${T3_SERVER_USER}:$(id -gn "$T3_SERVER_USER")" "$tmp"
  fi
  chmod 0600 "$tmp"
  mv -f "$tmp" "$SESSION_ENV"
}

# The server owns the data volume and uses the user's provider logins, so every
# other command runs as the configured user. Root drops to it.
ensure_server_user() {
  [ "$(id -un)" = "$T3_SERVER_USER" ] && return 0
  [ "$(id -u)" -eq 0 ] || fail "run this as '${T3_SERVER_USER}' (current user: $(id -un))"
  id "$T3_SERVER_USER" >/dev/null 2>&1 || fail "user '${T3_SERVER_USER}' does not exist in this container"
  local identity=("HOME=${T3_SERVER_USER_HOME}" "USER=${T3_SERVER_USER}" "LOGNAME=${T3_SERVER_USER}")
  if command -v runuser >/dev/null 2>&1; then
    exec runuser -u "$T3_SERVER_USER" -- env "${identity[@]}" "$0" "$@"
  fi
  if command -v setpriv >/dev/null 2>&1; then
    exec setpriv --reuid "$T3_SERVER_USER" --regid "$(id -gn "$T3_SERVER_USER")" --init-groups \
      env "${identity[@]}" "$0" "$@"
  fi
  fail "cannot switch to '${T3_SERVER_USER}': neither runuser nor setpriv is available"
}

# A number from the server's runtime file, which the server writes when it
# starts. The app uses the same file to find a running server.
runtime_field() {
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" "$RUNTIME_FILE" 2>/dev/null | head -n 1
}

# Prints "<pid> <port>" of the running server, or fails. The runtime file
# outlives the process, and after a container restart its pid can belong to
# something else, so the process has to be this user's T3 Code server.
server_process() {
  local pid port args
  pid="$(runtime_field pid)"
  port="$(runtime_field port)"
  [ -n "$pid" ] && [ -n "$port" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  args="$(tr '\0' ' ' <"/proc/${pid}/cmdline" 2>/dev/null)" || return 1
  [[ " $args" == *" serve "* ]] || return 1
  [ "$(stat -c %U "/proc/${pid}" 2>/dev/null)" = "$T3_SERVER_USER" ] || return 1
  echo "$pid $port"
}

# The server's self-description, or nothing if it does not answer.
descriptor() {
  local url="http://127.0.0.1:$1/.well-known/t3/environment"
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 3 "$url" 2>/dev/null || true
  else
    wget -qO- -T 3 "$url" 2>/dev/null || true
  fi
}

json_string() {
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n 1
}

# At startup the server prints an administrative pairing token three ways: as
# a token, inside a URL, and as a terminal QR code of that URL.
redact() {
  grep -v -e "Token:" -e "Pairing URL:" -e "pairingUrl" -e "[█▀▄]" || true
}

require_data_dir() {
  if [ ! -d "$DATA_DIR" ] || [ ! -w "$DATA_DIR" ]; then
    fail "${DATA_DIR} is not writable by $(id -un) (owner uid $(stat -c %u "$DATA_DIR" 2>/dev/null || echo '?'), yours $(id -u)). Run 'docker exec -u root <container> t3-server prepare' to repair it"
  fi
}

# Everything in the data volume that has to exist before an SSH session
# starts. Safe to run repeatedly.
cmd_prepare() {
  require_data_dir
  umask 077

  if [ ! -f "$HOST_KEY" ]; then
    mkdir -p "$(dirname "$HOST_KEY")"
    ssh-keygen -q -t ed25519 -N "" -C "t3-server" -f "$HOST_KEY"
  fi

  # Left in the volume by 0.3 and earlier, which ran the server itself. The
  # old log holds an administrative pairing token. The runtime link pointed
  # into the image, which no longer has a server.
  rm -f "${DATA_DIR}/server.log" "${DATA_DIR}/server.log.1" "${DATA_DIR}/server.pid"
  local link
  for link in "${T3_HOME}"/runtime/versions/*; do
    if [ -L "$link" ] && [[ "$(readlink "$link")" == /opt/t3-server/* ]]; then
      rm -f "$link"
    fi
  done
}

cmd_status() {
  local process pid port described version label
  if ! process="$(server_process)"; then
    echo "t3-server: not running. The T3 Code app starts it when it connects to this environment."
    return 3
  fi
  read -r pid port <<<"$process"
  described="$(descriptor "$port")"
  if [ -z "$described" ]; then
    echo "t3-server: process ${pid} is up but not answering on port ${port}"
    return 4
  fi
  version="$(json_string serverVersion <<<"$described")"
  label="$(json_string label <<<"$described")"
  echo "t3-server: running, pid ${pid}, T3 Code ${version:-?}, port ${port} in the container, named '${label}'"
}

cmd_stop() {
  local process pid port waited=0
  if ! process="$(server_process)"; then
    echo "t3-server: not running"
    return 0
  fi
  read -r pid port <<<"$process"
  kill "$pid" 2>/dev/null || true
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 10 ]; do
    sleep 1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null || true
  fi
  echo "t3-server: stopped. The T3 Code app starts it again when it reconnects."
}

cmd_logs() {
  local lines=50 log="" candidate
  if [ "${1:-}" = "-n" ] && [[ "${2:-}" =~ ^[0-9]+$ ]]; then
    lines="$2"
  fi
  # The app's launcher keeps one directory per way of reaching the container;
  # the most recently written log belongs to the server that runs now.
  for candidate in "${T3_HOME}"/ssh-launch/*/server.log; do
    [ -f "$candidate" ] || continue
    if [ -z "$log" ] || [ "$candidate" -nt "$log" ]; then
      log="$candidate"
    fi
  done
  [ -n "$log" ] || fail "no server log yet; the T3 Code app has not started a server in this container"
  tail -n "$lines" "$log" | redact
}

command="${1:-}"
case "$command" in
  status | stop | logs | prepare | label | session-env) ;;
  start | restart)
    # Kept so that a postStartCommand written for 0.x, which started the
    # server itself, does not fail the container start.
    echo "t3-server: nothing to do; since feature 1.0.0 the T3 Code app starts the server when it connects. 't3-server stop' makes it start a fresh one."
    exit 0
    ;;
  -h | --help | help | "")
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if [ "$command" = "label" ]; then
  # Needs no particular user and must print nothing else: t3-dev reads it.
  environment_label
  echo
  exit 0
fi
if [ "$command" = "session-env" ]; then
  cmd_session_env
  exit 0
fi

repair_data_owner
apply_environment_label
ensure_server_user "$@"
shift
case "$command" in
  prepare) cmd_prepare ;;
  status) cmd_status ;;
  stop) cmd_stop ;;
  logs) cmd_logs "$@" ;;
esac
