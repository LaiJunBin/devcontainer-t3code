#!/usr/bin/env bash
# Host-side helper for the t3-server dev container feature, for Docker running
# inside WSL with the T3 Code desktop app on Windows.
#
# It makes each dev container that has the feature show up as an SSH host named
# t3-<folder> for Windows' ssh.exe, which is what T3 Code's SSH connection mode
# uses. Nothing is published and no SSH daemon runs: the connection is carried
# over `docker exec`.
set -euo pipefail

# This tool's own version, independent of the feature's. Bump it when this
# file changes; the Release workflow publishes it as t3-dev-v<version>.
T3_DEV_VERSION=0.4.1
T3_DEV_REPO=laijunbin/devcontainer-t3code

MANAGED_NAME=t3-containers.conf
KNOWN_HOSTS_NAME=known_hosts_t3_containers
INCLUDE_LINE="Include ${MANAGED_NAME}"
INSTALL_PATH="${HOME}/.local/bin/t3-dev"
STATE_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/t3-dev/state"
UNIT_NAME=t3-dev-watch.service
UNIT_PATH="${HOME}/.config/systemd/user/${UNIT_NAME}"
SESSION=/usr/local/share/t3-server/ssh-session
FEATURE_CONFIG=/usr/local/share/t3-server/config
MACHINE_INFO=/etc/machine-info
# The line the feature puts above a PRETTY_HOSTNAME it wrote. A file written
# here carries it too, so the feature takes over again once it has a name of
# its own, such as a T3_SERVER_LABEL set later.
LABEL_MARKER="# PRETTY_HOSTNAME written by the t3-server dev container feature"
# A server this young has no work running that a restart could interrupt.
RESTART_WITHIN_SECONDS=120

usage() {
  cat <<EOF
Usage: t3-dev <command>

  setup     one-time: install this tool, hook it into Windows' SSH config, and
            keep the host list in sync automatically where systemd is available
  sync      write the running dev containers that have the feature as SSH hosts
  list      show the hosts of running dev containers; -a adds stopped ones
  watch     sync whenever a container starts or stops (what the service runs)
  remove    undo setup
  update    replace this tool with the latest release, after asking (--yes
            skips the question)
  version   print this tool's version

In T3 Code: Settings → Connections → Add environment → SSH, then pick or type
one of the t3-<folder> names.
EOF
}

fail() {
  echo "t3-dev: $1" >&2
  exit 1
}

# Everything that needs Windows interop or the interactive PATH is resolved
# once, in setup, and stored. The watch service and ssh's ProxyCommand run with
# a bare environment where cmd.exe is not reachable.
T3_DEV_SSH_DIR=""
T3_DEV_DISTRO=""
T3_DEV_DOCKER=""

load_state() {
  [ -f "$STATE_FILE" ] || fail "not set up yet; run 't3-dev setup' first"
  # shellcheck source=/dev/null
  . "$STATE_FILE"
  if [ -z "$T3_DEV_SSH_DIR" ] || [ -z "$T3_DEV_DISTRO" ] || [ ! -x "$T3_DEV_DOCKER" ]; then
    fail "${STATE_FILE} is incomplete; run 't3-dev setup' again"
  fi
}

# The Windows user profile as a WSL path. T3_DEV_WINHOME overrides it for tests.
windows_home() {
  if [ -n "${T3_DEV_WINHOME:-}" ]; then
    printf '%s' "$T3_DEV_WINHOME"
    return
  fi
  command -v cmd.exe >/dev/null 2>&1 || fail "cmd.exe not found; run setup from a WSL terminal"
  local profile
  profile="$(cd /mnt/c && cmd.exe /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r')"
  [ -n "$profile" ] || fail "could not read the Windows user profile path"
  wslpath -u "$profile"
}

# VS Code records a WSL folder as \\wsl.localhost\<distro>\home\... while the
# devcontainer CLI records /home/...; compare them in the Linux form. A folder
# on a Windows drive (c:\...) has no Linux form and is kept as it is.
normalize_folder() {
  local folder="$1"
  case "$folder" in
    '\\wsl'*)
      folder="${folder//\\//}"
      folder="/${folder#//*/*/}"
      ;;
  esac
  printf '%s' "${folder%/}"
}

# A folder as one shell-safe word, for the ProxyCommand line: any path works,
# including ones with spaces or backslashes.
encode_folder() {
  printf '%s' "$1" | base64 -w0 | tr '+/' '-_' | tr -d '='
}

decode_folder() {
  local value="$1"
  case $((${#value} % 4)) in
    2) value="${value}==" ;;
    3) value="${value}=" ;;
  esac
  printf '%s' "$value" | tr -- '-_' '+/' | base64 -d 2>/dev/null
}

# Prints "<container id>\t<folder>" for every running dev container.
running_dev_containers() {
  local id folder
  while IFS=$'\t' read -r id folder; do
    [ -n "$folder" ] || continue
    printf '%s\t%s\n' "$id" "$(normalize_folder "$folder")"
  done < <("$T3_DEV_DOCKER" ps --format '{{.ID}}\t{{.Label "devcontainer.local_folder"}}')
}

# Prints "<container id>\t<state>\t<folder>" for every dev container that
# exists, stopped ones included. The state is docker's: running, exited, ...
all_dev_containers() {
  local id state folder
  while IFS=$'\t' read -r id state folder; do
    [ -n "$folder" ] || continue
    printf '%s\t%s\t%s\n' "$id" "$state" "$(normalize_folder "$folder")"
  done < <("$T3_DEV_DOCKER" ps -a --format '{{.ID}}\t{{.State}}\t{{.Label "devcontainer.local_folder"}}')
}

# Succeeds when a workspace folder is known to be gone. A folder on a Windows
# drive (c:\...) is looked for under /mnt/<drive>, where WSL mounts drives by
# default; where that is not a mount the folder cannot be checked from here
# and counts as still there. It has to be a mount, not just a directory: an
# unmounted drive must not make every project on it look deleted.
# T3_DEV_DRIVE_ROOT replaces /mnt for tests.
folder_is_gone() {
  local folder="$1" path="$1"
  if [[ "$folder" =~ ^([A-Za-z]):[\\/](.*)$ ]]; then
    local drive="${BASH_REMATCH[1],,}" rest="${BASH_REMATCH[2]//\\//}"
    path=""
    if [ -n "${T3_DEV_DRIVE_ROOT:-}" ]; then
      [ -d "${T3_DEV_DRIVE_ROOT}/${drive}" ] && path="${T3_DEV_DRIVE_ROOT}/${drive}/${rest}"
    elif mountpoint -q "/mnt/${drive}" 2>/dev/null; then
      path="/mnt/${drive}/${rest}"
    fi
  fi
  [[ "$path" == /* ]] && [ ! -d "$path" ]
}

# The user-level systemd manager is what keeps the watcher running. Without it
# (older WSL, systemd disabled) the tool still works with a manual 'sync'.
have_user_systemd() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

install_watch_service() {
  mkdir -p "$(dirname "$UNIT_PATH")"
  cat >"$UNIT_PATH" <<EOF
[Unit]
Description=Keep T3 Code's SSH host list in sync with running dev containers

[Service]
ExecStart=${INSTALL_PATH} watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable "$UNIT_NAME" >/dev/null 2>&1
  systemctl --user restart "$UNIT_NAME"
}

cmd_setup() {
  local win_home ssh_dir config docker_bin
  win_home="$(windows_home)"
  [ -n "${WSL_DISTRO_NAME:-}" ] || fail "WSL_DISTRO_NAME is not set; run setup from a WSL terminal"
  docker_bin="$(command -v docker)" || fail "docker not found on PATH"
  ssh_dir="${win_home}/.ssh"
  config="${ssh_dir}/config"

  if [ "$(readlink -f "$0")" != "$(readlink -f "$INSTALL_PATH" 2>/dev/null || true)" ]; then
    mkdir -p "$(dirname "$INSTALL_PATH")"
    install -m 0755 "$0" "$INSTALL_PATH"
  fi

  mkdir -p "$(dirname "$STATE_FILE")"
  {
    echo "# Written by 't3-dev setup'."
    printf 'T3_DEV_SSH_DIR=%q\n' "$ssh_dir"
    printf 'T3_DEV_DISTRO=%q\n' "$WSL_DISTRO_NAME"
    printf 'T3_DEV_DOCKER=%q\n' "$(readlink -f "$docker_bin")"
  } >"$STATE_FILE"

  mkdir -p "$ssh_dir"
  [ -f "${ssh_dir}/${MANAGED_NAME}" ] || : >"${ssh_dir}/${MANAGED_NAME}"
  # Include has to come before any Host block to apply to the whole file.
  if [ ! -f "$config" ]; then
    printf '%s\n' "$INCLUDE_LINE" >"$config"
  elif ! grep -qxF "$INCLUDE_LINE" "$config"; then
    [ -f "${config}.before-t3" ] || cp "$config" "${config}.before-t3"
    { printf '%s\n\n' "$INCLUDE_LINE"; cat "$config"; } >"${config}.tmp"
    mv "${config}.tmp" "$config"
  fi

  echo "t3-dev: installed to ${INSTALL_PATH} and hooked into Windows' SSH config."
  "$INSTALL_PATH" sync || true
  if [ -n "${T3_DEV_NO_SERVICE:-}" ]; then
    :
  elif have_user_systemd && install_watch_service; then
    echo "t3-dev: the host list now follows your containers automatically (${UNIT_NAME})."
    echo "  Check it with: systemctl --user status ${UNIT_NAME}"
  else
    echo "t3-dev: no user systemd here, so run 't3-dev sync' after starting a new project's container."
  fi
}

cmd_sync() {
  load_state
  local ssh_dir="$T3_DEV_SSH_DIR" managed id folder user name base shown wanted count=0
  managed="${ssh_dir}/${MANAGED_NAME}"
  if ! grep -qxF "$INCLUDE_LINE" "${ssh_dir}/config" 2>/dev/null; then
    fail "the Include line is missing from ${ssh_dir}/config; run 't3-dev setup' again"
  fi

  # Without an answer from docker every container would look deleted and its
  # host would be dropped.
  "$T3_DEV_DOCKER" ps -q >/dev/null 2>&1 || fail "docker is not answering; the host list was left as it is"

  local tmp seen=" " seen_folders=$'\n'
  tmp="$(mktemp)"
  {
    echo "# Written by 't3-dev sync'. Do not edit; rerun the command instead."
    echo "# Each host is a dev container in WSL (${T3_DEV_DISTRO}), reached over 'docker exec'."
  } >"$tmp"

  # T3 Code remembers an environment by its SSH host, so a folder's host must
  # not change under it: not when the project's label changes, and not when
  # another project with the same folder name starts or stops. The hosts the
  # previous sync gave out are therefore kept, per folder. A folder whose
  # container was removed has no Host entry but keeps its name in a
  # "#reserved <host> <folder>" line, so a rebuild gets the same host back.
  local -A previous_host=()
  local taken=" " line previous_folder="" reserved
  if [ -f "$managed" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        "# Written by"* | "# Each host"*) ;;
        "# "*) previous_folder="${line#\# }" ;;
        "Host "*)
          if [ -n "$previous_folder" ]; then
            previous_host["$previous_folder"]="${line#Host }"
            taken="${taken}${line#Host } "
          fi
          ;;
        "#reserved "*)
          reserved="${line#\#reserved }"
          previous_host["${reserved#* }"]="${reserved%% *}"
          taken="${taken}${reserved%% *} "
          ;;
      esac
    done <"$managed"
  fi

  # Folders that still have a container, running or not.
  local existing_folders=$'\n' state
  while IFS=$'\t' read -r id state folder; do
    existing_folders="${existing_folders}${folder}"$'\n'
  done < <(all_dev_containers)

  while IFS=$'\t' read -r id folder; do
    # One host per folder. 'connect' finds the container by folder, so a
    # second container of the same folder could not be reached separately.
    [[ "$seen_folders" == *$'\n'"${folder}"$'\n'* ]] && continue
    "$T3_DEV_DOCKER" exec "$id" test -x "$SESSION" </dev/null 2>/dev/null || continue
    user="$("$T3_DEV_DOCKER" exec "$id" sh -c ". ${FEATURE_CONFIG} && printf %s \"\$T3_SERVER_USER\"" </dev/null 2>/dev/null)" || continue
    [[ "$user" =~ ^[A-Za-z0-9._-]+$ ]] || continue

    # The host is t3-<folder name>, built the way the feature builds its
    # default label, so the two are the same unless T3_SERVER_LABEL is set.
    base="${folder//\\//}"
    base="t3-$(basename "$base" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-\n' '-')"
    name="${previous_host["$folder"]:-}"
    # A host from before that is not of this form (older versions named it
    # after the label) is replaced.
    if [[ ! "$name" =~ ^"$base"(-[0-9]+)?$ ]] || [[ "$seen" == *" ${name} "* ]]; then
      name="$base"
      local suffix=2
      # Another folder's host is not reused even while its container is
      # stopped: T3 Code may still have an environment saved under it.
      while [[ "$seen" == *" ${name} "* ]] ||
        { [[ "$taken" == *" ${name} "* ]] && [ "${previous_host["$folder"]:-}" != "$name" ]; }; do
        name="${base}-${suffix}"
        suffix=$((suffix + 1))
      done
    fi
    seen="${seen}${name} "
    seen_folders="${seen_folders}${folder}"$'\n'

    # What T3 Code shows for the environment once it is added, kept next to
    # the host for 'list'. It comes from the container and ends up on the
    # terminal: no control characters.
    shown="$("$T3_DEV_DOCKER" exec "$id" t3-server label </dev/null 2>/dev/null | head -n 1 | tr -d '[:cntrl:]' || true)"
    wanted=""
    if [ -z "$shown" ]; then
      # The feature has no name for this one: the project is not mounted at
      # /workspaces/<folder>, as with Docker Compose, or the feature is older
      # than its 'label' command. The folder is known here, so name it.
      name_environment "$id" "$name"
    fi

    cat >>"$tmp" <<EOF

# ${folder}
#label ${shown}${wanted:+
#wanted ${wanted}}
Host ${name}
    User ${user}
    ProxyCommand wsl.exe -d ${T3_DEV_DISTRO} -- ${INSTALL_PATH} connect ${name} $(encode_folder "$folder")
    PubkeyAuthentication no
    UserKnownHostsFile ~/.ssh/${KNOWN_HOSTS_NAME}
    StrictHostKeyChecking accept-new
    LogLevel ERROR
EOF
    printf '  %-28s %s\n' "$name" "$folder"
    count=$((count + 1))
  done < <(running_dev_containers)

  # A stopped container keeps its entry: connecting to it reports that it is
  # not running, which is more useful than the host vanishing. A container
  # that was removed loses its entry and keeps only its reserved name.
  if [ -f "$managed" ]; then
    local kept
    kept="$(carry_over_stopped "$managed" "$seen" "$seen_folders" "$existing_folders")"
    if [ -n "$kept" ]; then
      printf '%s\n' "$kept" >>"$tmp"
    fi
  fi

  if [ -f "$managed" ] && cmp -s "$tmp" "$managed"; then
    rm -f "$tmp"
  else
    cat "$tmp" >"$managed"
    rm -f "$tmp"
    # Host keys change when a container's data volume is recreated; forgetting
    # them here keeps that from turning into a "host key changed" error.
    rm -f "${ssh_dir}/${KNOWN_HOSTS_NAME}"
  fi

  if [ "$count" -eq 0 ]; then
    echo "t3-dev: no running dev container has the t3-server feature with ssh enabled."
  else
    echo "t3-dev: ${count} running host(s). In T3 Code: Add environment → SSH → one of the names above."
  fi
}

# Gives the environment in container $1 the name $2, for a container whose
# feature found none. Sets 'shown' to what T3 Code gets now and 'wanted' to
# the name when the running server does not use it yet.
#
# T3 Code takes the name from PRETTY_HOSTNAME in /etc/machine-info, read once
# when the server starts. The feature's entrypoint starts the server before
# anything here can run, so right after the file is written the server still
# calls itself by the container's hostname and has to be restarted. That is
# only done in a container that started moments ago, where nothing can be
# running yet; an older one keeps its server and gets the name the next time
# the container starts.
name_environment() {
  local id="$1" name="$2" current content served started age autostart
  shown=""
  wanted=""
  content="${LABEL_MARKER}"$'\n'"PRETTY_HOSTNAME=\"${name}\""
  current="$("$T3_DEV_DOCKER" exec "$id" cat "$MACHINE_INFO" </dev/null 2>/dev/null || true)"

  # A machine-info that neither the feature nor this tool wrote is the
  # image's own and stays.
  if [ -n "$current" ] && ! grep -qxF "$LABEL_MARKER" <<<"$current"; then
    shown="$(sed -n 's/^PRETTY_HOSTNAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' <<<"$current" | head -n 1 | tr -d '[:cntrl:]')"
    [ -n "$shown" ] || shown="$(container_hostname "$id")"
    return 0
  fi

  if [ "$current" != "$content" ]; then
    if ! printf '%s\n' "$content" |
      "$T3_DEV_DOCKER" exec -i -u root "$id" sh -c "cat >$MACHINE_INFO" 2>/dev/null; then
      shown="$(container_hostname "$id")"
      return 0
    fi
    started="$("$T3_DEV_DOCKER" inspect -f '{{.State.StartedAt}}' "$id" 2>/dev/null || true)"
    age=$(($(date +%s) - $(date -d "$started" +%s 2>/dev/null || echo 0)))
    autostart="$("$T3_DEV_DOCKER" exec "$id" sh -c ". ${FEATURE_CONFIG} && printf %s \"\${T3_SERVER_AUTOSTART:-true}\"" </dev/null 2>/dev/null || true)"
    if [ "$age" -le "$RESTART_WITHIN_SECONDS" ] && [ "$autostart" = "true" ]; then
      "$T3_DEV_DOCKER" exec -u root "$id" sh -c "t3-server stop; t3-server start --no-wait" </dev/null >/dev/null 2>&1 || true
      shown="$name"
      return 0
    fi
  fi

  # Not restarted: say what the running server answers with, if it answers.
  served="$("$T3_DEV_DOCKER" exec "$id" sh -c ". ${FEATURE_CONFIG} && url=\"http://127.0.0.1:\${T3CODE_PORT:-\$T3_SERVER_PORT}/.well-known/t3/environment\" && { curl -fsS --max-time 3 \"\$url\" 2>/dev/null || wget -qO- -T 3 \"\$url\" 2>/dev/null; }" </dev/null 2>/dev/null |
    sed -n 's/.*"label":"\([^"]*\)".*/\1/p' | head -n 1 | tr -d '[:cntrl:]' || true)"
  if [ -n "$served" ] && [ "$served" != "$name" ]; then
    shown="$served"
    wanted="$name"
  else
    shown="$name"
  fi
}

container_hostname() {
  "$T3_DEV_DOCKER" exec "$1" hostname </dev/null 2>/dev/null | head -n 1 | tr -d '[:cntrl:]' || true
}

# Prints what to keep from the previous host file ($1) for folders that were
# not just written ($3, one per line; $2 holds the names just given out):
# the whole entry while the folder still has a container ($4, one per line),
# otherwise only the reserved name while the folder itself exists.
carry_over_stopped() {
  local file="$1" seen="$2" seen_folders="$3" existing_folders="$4"
  local line folder="" name="" block="" reserved
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "# Written by"* | "# Each host"*) ;;
      "# "*)
        emit_carried "$name" "$folder" "$block" "$seen" "$seen_folders" "$existing_folders"
        folder="${line#\# }"
        name=""
        block="$line"
        ;;
      "#label "* | "#wanted "*)
        [ -n "$block" ] && block+=$'\n'"$line"
        ;;
      "Host "*)
        name="${line#Host }"
        block+=$'\n'"$line"
        ;;
      "    "*)
        [ -n "$block" ] && block+=$'\n'"$line"
        ;;
      "#reserved "*)
        emit_carried "$name" "$folder" "$block" "$seen" "$seen_folders" "$existing_folders"
        name=""
        folder=""
        block=""
        reserved="${line#\#reserved }"
        emit_carried "${reserved%% *}" "${reserved#* }" "" "$seen" "$seen_folders" "$existing_folders"
        ;;
    esac
  done <"$file"
  emit_carried "$name" "$folder" "$block" "$seen" "$seen_folders" "$existing_folders"
}

# One entry of the previous file: name, folder, and its Host block, which is
# empty for a name that was only reserved.
emit_carried() {
  local name="$1" folder="$2" block="$3" seen="$4" seen_folders="$5" existing_folders="$6"
  [ -n "$name" ] && [ -n "$folder" ] || return 0
  [[ "$seen" == *" ${name} "* ]] && return 0
  [[ "$seen_folders" == *$'\n'"${folder}"$'\n'* ]] && return 0
  if [ -n "$block" ] && [[ "$existing_folders" == *$'\n'"${folder}"$'\n'* ]]; then
    printf '\n%s\n' "$block"
  elif ! folder_is_gone "$folder"; then
    printf '\n#reserved %s %s\n' "$name" "$folder"
  fi
}

cmd_list() {
  local all=false
  case "${1:-}" in
    -a | --all) all=true ;;
    "") ;;
    *) fail "unknown option for list: $1" ;;
  esac
  load_state
  local managed="${T3_DEV_SSH_DIR}/${MANAGED_NAME}"
  [ -f "$managed" ] || fail "nothing synced yet; run 't3-dev sync'"

  # The file is as of the last sync; states and container IDs are asked for
  # now. A folder with several containers shows the running one.
  local -A container_of=() state_of=()
  local id state folder
  while IFS=$'\t' read -r id state folder; do
    [ "${state_of["$folder"]:-}" = running ] && continue
    container_of["$folder"]="$id"
    state_of["$folder"]="$state"
  done < <(all_dev_containers 2>/dev/null)

  # T3 CODE NAME is what the environment is called in T3 Code once added. It
  # equals the host unless T3_SERVER_LABEL is set or two projects share a
  # folder name; the "Add environment" picker shows the host.
  local line shown="" wanted="" host rows=0 hidden=0
  local -a pending=()
  local -A shown_count=()
  folder=""
  printf '  %-28s %-24s %-8s %-13s %s\n' "HOST" "T3 CODE NAME" "STATE" "CONTAINER" "FOLDER"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "# Written by"* | "# Each host"*) ;;
      "# "*)
        folder="${line#\# }"
        shown=""
        wanted=""
        ;;
      "#label "*) shown="${line#\#label }" ;;
      "#wanted "*) wanted="${line#\#wanted }" ;;
      "Host "*)
        host="${line#Host }"
        id="${container_of["$folder"]:-}"
        # Removed since the last sync; the next one drops the entry.
        [ -n "$id" ] || continue
        state=stopped
        [ "${state_of["$folder"]}" = running ] && state=running
        if [ "$state" = stopped ] && ! "$all"; then
          hidden=$((hidden + 1))
          continue
        fi
        printf '  %-28s %-24s %-8s %-13s %s\n' "$host" "${shown:-$host}" "$state" "$id" "$folder"
        shown_count["${shown:-$host}"]=$((${shown_count["${shown:-$host}"]:-0} + 1))
        rows=$((rows + 1))
        if [ -n "$wanted" ] && [ "$state" = running ]; then
          pending+=("${host}: becomes '${wanted}' when its container next starts, or now with: docker exec ${id} t3-server restart")
        fi
        ;;
    esac
  done <"$managed"

  if [ "$rows" -eq 0 ]; then
    echo "  (none)"
  fi
  if [ "$hidden" -gt 0 ]; then
    echo
    echo "  ${hidden} stopped; 't3-dev list -a' shows them too."
  fi

  # A name given by 'sync' to a server that was already busy: it was not
  # restarted, since that would stop whatever its agents are doing.
  if [ "${#pending[@]}" -gt 0 ]; then
    echo
    for line in "${pending[@]}"; do
      echo "  ${line}"
    done
  fi

  # The server names the environment and cannot know about other projects, so
  # two projects with the same folder name look alike in T3 Code.
  for shown in "${!shown_count[@]}"; do
    if [ "${shown_count["$shown"]}" -gt 1 ]; then
      echo
      echo "  ${shown_count["$shown"]} hosts are shown as '${shown}' in T3 Code. To tell them apart there, set"
      echo "  \"containerEnv\": { \"T3_SERVER_LABEL\": \"<name>\" } in one project's devcontainer.json and rebuild it."
    fi
  done
}

# Runs until stopped: resync shortly after any container starts, stops or is
# removed.
# Messages go to stderr, which the service's journal keeps.
cmd_watch() {
  load_state
  echo "t3-dev: watching containers start, stop and get removed" >&2
  "$INSTALL_PATH" sync >&2 || echo "t3-dev: sync failed; will retry on the next container event" >&2
  # Only the arrival of an event matters, not its content. .Action is used
  # because it exists in every Docker version; the older top-level .ID field
  # was removed and makes `docker events` exit with a template error.
  # docker's own error output is left on stderr so it reaches the journal.
  # When docker exits, the loop ends and the service restarts.
  while read -r _; do
    # A dev container start is a burst of events; let it settle, then drain
    # whatever else arrived so one burst means one sync.
    sleep 3
    while read -r -t 1 _; do :; done
    "$INSTALL_PATH" sync >&2 || echo "t3-dev: sync failed; will retry on the next container event" >&2
  done < <("$T3_DEV_DOCKER" events --filter type=container --filter event=start --filter event=die --filter event=destroy --format '{{.Action}}')
  fail "docker events ended; is the Docker daemon running? The service will restart"
}

# Called by ssh through ProxyCommand as: connect <host name> <encoded folder>.
# stdin/stdout carry the SSH protocol, so nothing may be printed to stdout.
cmd_connect() {
  load_state
  local name="${1:-}" wanted id folder found=""
  [ -n "${2:-}" ] || fail "connect needs a host name and a folder"
  wanted="$(decode_folder "$2")" || fail "could not decode the folder for ${name}"
  [ -n "$wanted" ] || fail "could not decode the folder for ${name}"
  while IFS=$'\t' read -r id folder; do
    if [ "$folder" = "$wanted" ]; then
      found="$id"
      break
    fi
  done < <(running_dev_containers)
  [ -n "$found" ] || fail "${name}: the dev container for ${wanted} is not running. Start it, then try again"
  # Outside the loop on purpose: inside it, stdin is the container list, not
  # the SSH stream this command has to carry.
  exec "$T3_DEV_DOCKER" exec -i -u root "$found" "$SESSION"
}

cmd_remove() {
  local ssh_dir config
  if [ -f "$STATE_FILE" ]; then
    # shellcheck source=/dev/null
    . "$STATE_FILE"
    ssh_dir="$T3_DEV_SSH_DIR"
  else
    ssh_dir="$(windows_home)/.ssh"
  fi
  config="${ssh_dir}/config"

  if command -v systemctl >/dev/null 2>&1 && [ -f "$UNIT_PATH" ]; then
    systemctl --user disable --now "$UNIT_NAME" >/dev/null 2>&1 || true
    rm -f "$UNIT_PATH"
    systemctl --user daemon-reload >/dev/null 2>&1 || true
  fi

  rm -f "${ssh_dir}/${MANAGED_NAME}" "${ssh_dir}/${KNOWN_HOSTS_NAME}" "$STATE_FILE"
  # Edit the config as it is now instead of restoring the backup, so anything
  # written to it since setup is kept. Only the Include line goes, together
  # with the blank line setup put after it.
  if [ -f "$config" ]; then
    # Lines are compared without a trailing CR but printed as they are, so a
    # file with Windows line endings keeps them.
    awk -v include="$INCLUDE_LINE" '
      { bare = $0; sub(/\r$/, "", bare) }
      bare == include { dropped = NR; next }
      dropped && NR == dropped + 1 && bare == "" { next }
      { print }
    ' "$config" >"${config}.tmp"
    if [ -s "${config}.tmp" ]; then
      mv "${config}.tmp" "$config"
    else
      # setup created the file and nothing else was ever added to it.
      rm -f "${config}.tmp" "$config"
    fi
  fi
  echo "t3-dev: removed. Your SSH config keeps everything else that is in it now."
  echo "  ${config}.before-t3, if present, is the copy taken at setup; delete it when you no longer want it."
  echo "  ${INSTALL_PATH} is left in place; delete it to finish uninstalling."
}

# Replaces the installed tool with the one attached to the latest GitHub
# release. Nothing else in this tool goes to the network, and this only does
# when asked to: a tool that edits the Windows SSH config should not change
# itself in the background.
cmd_update() {
  local assume_yes=false
  case "${1:-}" in
    -y | --yes) assume_yes=true ;;
    "") ;;
    *) fail "unknown option for update: $1" ;;
  esac
  [ -x "$INSTALL_PATH" ] || fail "not set up yet; run 't3-dev setup' first"
  command -v curl >/dev/null 2>&1 || fail "update needs curl"
  command -v sha256sum >/dev/null 2>&1 || fail "update needs sha256sum"

  # T3_DEV_RELEASE_BASE_URL points at a mirror of the release's files. Only
  # the default location is restricted to HTTPS.
  local base="${T3_DEV_RELEASE_BASE_URL:-}" work
  local -a fetch=(curl -fsSL --max-time 60)
  if [ -z "$base" ]; then
    base="https://github.com/${T3_DEV_REPO}/releases/latest/download"
    fetch+=(--proto '=https' --tlsv1.2)
  fi
  work="$(mktemp -d)"
  # shellcheck disable=SC2064 # expand now: $work is local to this function
  trap "rm -rf '${work}'" EXIT

  "${fetch[@]}" -o "${work}/t3-dev" "${base}/t3-dev" ||
    fail "could not download ${base}/t3-dev"
  "${fetch[@]}" -o "${work}/t3-dev.sha256" "${base}/t3-dev.sha256" ||
    fail "could not download ${base}/t3-dev.sha256"

  # Catches a damaged download. The hash comes from the same place as the
  # file, so it says nothing about who published it; the attestation does.
  local expected actual
  expected="$(awk 'NR == 1 { print $1 }' "${work}/t3-dev.sha256")"
  actual="$(sha256sum "${work}/t3-dev" | awk '{ print $1 }')"
  [[ "$expected" =~ ^[0-9a-f]{64}$ ]] || fail "the published checksum is not a SHA-256 hash"
  [ "$expected" = "$actual" ] || fail "checksum mismatch: the download is damaged or was altered"
  bash -n "${work}/t3-dev" 2>/dev/null || fail "the downloaded file is not a valid script"

  local latest
  latest="$(sed -n 's/^T3_DEV_VERSION=\([0-9][0-9A-Za-z.-]*\)$/\1/p' "${work}/t3-dev" | head -n 1)"
  [ -n "$latest" ] || fail "the downloaded file does not state its version"
  if cmp -s "${work}/t3-dev" "$INSTALL_PATH"; then
    echo "t3-dev: already up to date (${latest})."
    return 0
  fi

  # The release workflow signs the file through GitHub's artifact
  # attestations: proof, kept in a public transparency log, that this exact
  # file was built by that workflow in this repository. Checking it needs the
  # GitHub CLI, signed in.
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    gh attestation verify "${work}/t3-dev" --repo "$T3_DEV_REPO" \
      --signer-workflow "${T3_DEV_REPO}/.github/workflows/release.yaml" >/dev/null 2>&1 ||
      fail "the download is not attested as built by ${T3_DEV_REPO}'s release workflow; not installing it"
    echo "t3-dev: verified as built by ${T3_DEV_REPO}'s release workflow."
  else
    echo "t3-dev: checksum matches. Who built the file was not checked: that needs the"
    echo "  GitHub CLI, signed in ('gh auth login'). See the README, 'Verifying a download'."
  fi

  local installed
  installed="$(sed -n 's/^T3_DEV_VERSION=\([0-9][0-9A-Za-z.-]*\)$/\1/p' "$INSTALL_PATH" | head -n 1)"
  echo "t3-dev: ${installed:-unknown version} → ${latest}"
  if ! "$assume_yes"; then
    [ -t 0 ] || fail "not a terminal; rerun as 't3-dev update --yes' to install without asking"
    local answer
    read -r -p "Install it? [y/N] " answer
    case "$answer" in
      y | Y | yes | YES) ;;
      *)
        echo "t3-dev: left as it was."
        return 0
        ;;
    esac
  fi

  # Moved into place rather than written over: this script is still being read
  # from the old file.
  install -m 0755 "${work}/t3-dev" "${INSTALL_PATH}.new"
  mv -f "${INSTALL_PATH}.new" "$INSTALL_PATH"
  rm -rf "$work"
  trap - EXIT
  echo "t3-dev: installed ${latest}."
  # The new version reapplies its own setup: service file, host list.
  exec "$INSTALL_PATH" setup
}

case "${1:-}" in
  setup) cmd_setup ;;
  update)
    shift
    cmd_update "$@"
    ;;
  sync) cmd_sync ;;
  list)
    shift
    cmd_list "$@"
    ;;
  watch) cmd_watch ;;
  remove) cmd_remove ;;
  version | --version | -V) echo "t3-dev ${T3_DEV_VERSION}" ;;
  connect)
    shift
    cmd_connect "$@"
    ;;
  -h | --help | help | "")
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
