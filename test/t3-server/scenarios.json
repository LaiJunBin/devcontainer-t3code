{
  "plain_ubuntu": {
    "image": "ubuntu:24.04",
    "remoteUser": "ubuntu",
    "features": {
      "t3-server": {}
    }
  },
  "rocky_with_user": {
    "image": "rockylinux:9",
    "remoteUser": "vscode",
    "features": {
      "ghcr.io/devcontainers/features/common-utils:2": {
        "username": "vscode",
        "installZsh": false,
        "installOhMyZsh": false
      },
      "t3-server": {}
    }
  },
  "not_strict_skips_root_image": {
    "image": "debian:12-slim",
    "features": {
      "t3-server": {
        "strict": false
      }
    }
  },
  "compose_project_mounted_elsewhere": {
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/srv/app",
    "remoteUser": "vscode",
    "features": {
      "t3-server": {}
    }
  },
  "app_launch": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
    "remoteUser": "vscode",
    "containerEnv": {
      "T3_TEST_MARK": "from-container-env"
    },
    "features": {
      "t3-server": {}
    }
  }
}
